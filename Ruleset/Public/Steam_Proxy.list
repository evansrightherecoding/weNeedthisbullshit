# NAME: Steam_Proxy
# AUTHOR: blackmatrix7
# REPO: https://github.com/blackmatrix7/ios_rule_script
# UPDATED: 2025-03-18
# DESCRIPTION: Steam需要代理的域名 - 部分功能/区域限制
# DOMAIN-SUFFIX: 8
# TOTAL: 8

# Clash matches domains, not URL paths. The steamcommunity.com rule also covers
# market, login, profiles, workshop, discussions and other community pages.

# Steam好友列表/聊天服务器（部分地区不稳定）
DOMAIN-SUFFIX,steamcommunity.com
DOMAIN-SUFFIX,steam-chat.com

# Steam创意工坊（部分地区访问慢）
DOMAIN-SUFFIX,steamworkshop.download

# Steam好友邀请
DOMAIN-SUFFIX,s.team

# Steam云存档同步（部分地区慢）
DOMAIN-SUFFIX,steamcloud.ugc

# Steam远程同乐
DOMAIN-SUFFIX,steamremoteplay.net

# Steam匹配服务器（部分游戏）
DOMAIN-SUFFIX,steamgamesnetwork.com

# Steam API
DOMAIN-SUFFIX,api.steampowered.com
